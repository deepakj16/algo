from collections import defaultdict 
class Solution(object):
    def is_dup(self, temp_s):
        d = defaultdict(int)
        for t in temp_s:
            if t in d.keys():
                return True
            else:
                d[t] += 1
        return False

    def lengthOfLongestSubstring(self, s):
        """
        :type s: str
        :rtype: int
        """
        max = 1
        for i in range(0, len(s)):
            for j in range(i+1, len(s)):
                temp_s = s[i:j+1]
                print(temp_s)
                if self.is_dup(temp_s):
                    print('is_dup ' +temp_s)
                    break
                elif len(temp_s)>max:
                    max = len(temp_s)
                    print(max)


        return max
    
        
